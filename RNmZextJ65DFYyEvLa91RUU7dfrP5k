		addToggle()
	end
	
	function hide2()
	
		for _, v in Main.List:GetChildren() do
			if not v:IsA("UIListLayout") and v.Visible then
				if v:IsA("TextLabel") then
					TweenService:Create(v, TweenInfo.new(0.25, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), {TextTransparency = 1}):Play()
	
				elseif v:IsA("TextButton") then
					TweenService:Create(v, TweenInfo.new(0.25, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), {TextTransparency = 1, BackgroundTransparency = 1}):Play()
				elseif v:IsA("TextBox") then
					TweenService:Create(v, TweenInfo.new(0.25, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), {TextTransparency = 1, BackgroundTransparency = 1}):Play()
				elseif v:IsA("Frame") then
					TweenService:Create(v, TweenInfo.new(0.25, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), {BackgroundTransparency = 1}):Play()
				end
			end
			if v:IsA("UIStroke") then
				TweenService:Create(v, TweenInfo.new(0.25, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), {Transparency = 1}):Play()
			end
		end
	end
	
	function appear()
		local hidden = {}
	
		local function getSortedChildren()
			local children = {}
	
			for _, v in Main.List:GetChildren() do
				if v:IsA("GuiObject") then
					table.insert(children, v)
				end
			end
	
			table.sort(children, function(a, b)
				return a.LayoutOrder < b.LayoutOrder
			end)
	
			return children
		end
	
		local function hide()
			Main.Note2.TextTransparency = 1
	
			for _, v in ipairs(getSortedChildren()) do
				if v:IsA("TextLabel") then
					v.TextTransparency = 1
					table.insert(hidden, v)
	
				elseif (v:IsA("TextButton") or v:IsA("TextBox") or v:IsA("Frame")) then
					if v.Visible then
						v.Visible = false
						table.insert(hidden, v)
					end
				end
			end
		end
	
		local function show()
			table.sort(hidden, function(a, b)
				return (a.LayoutOrder or 0) < (b.LayoutOrder or 0)
			end)
	
			for _, v in ipairs(hidden) do
				if v:IsA("TextLabel") then
					TweenService:Create(
						v,
						TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
						{TextTransparency = 0}
					):Play()
	
				elseif v:IsA("TextButton") or v:IsA("TextBox") or v:IsA("Frame") then
					v.Visible = true
				end
	
				task.wait(0.3)
			end
	
			TweenService:Create(
				Main.Note2,
				TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{TextTransparency = 0}
			):Play()
		end
	
		hide()
		task.wait(1)
		show()
	end
	
	Creator.MakeDragable(Main)
	Creator.MakeDragable(HUD.Game)
	appear()
	
