			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = body
		})
	end
	
	local function FixName(id)
		local base = id:gsub("_(%d+)$", "")

		local parts = {}
		for part in string.gmatch(base, "[^_]+") do
			table.insert(parts, part)
		end

		if #parts == 1 then
			return parts[1]
		end

		local typeCode = parts[2]

		if typeCode == "K" then
			return parts[1] .. " Knife"
		elseif typeCode == "G" then
			return parts[1] .. " Gun"
		else
			return parts[1]
		end
	end
	
