			elseif id:find("_G_") then
				itemType = "Gun"
			end
		end
		
		local EventEmojis = {
			["Summer"] = "🍉",
			["Halloween"] = "🎃",
			["Christmas"] = "⛄",
			["Unknown"] = "❓",
