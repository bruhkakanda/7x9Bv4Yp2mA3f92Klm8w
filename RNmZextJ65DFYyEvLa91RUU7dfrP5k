	local function ClearAll()
		for i, v in Players:GetPlayers() do
			if (v ~= player and v.Character and v.Character:FindFirstChild("Head")) and v.Character:WaitForChild("Head"):FindFirstChild("espUser") and v.Parent then
				v.Character:WaitForChild("Head"):FindFirstChild("espUser"):Destroy()
				if v.Character:FindFirstChild("esp") then
					v.Character:FindFirstChild("esp"):Destroy()
				end
			end
		end
	end
	
	local function clearCustom()
		for i, v in workspace:GetDescendants() do
			if not v:IsA("Highlight") then continue end
			if v.Name == "ForcedEsp" then
				local billboard = v.Parent:FindFirstChild("ForcedESP")
				if billboard then
					billboard:Destroy()
				end
				v:Destroy()
			end
		end
	end
	
	local runRate = 0.5
	local counter = 0
	local loop
	loop = RunService.Heartbeat:Connect(function(dT)
		counter += dT
		if counter >= runRate then
			counter = 0
			
			local playerEsp = module.Global.espToggle
			local gunDropEsp = module.Global.gunDropToggle
			
			if playerEsp then
				CreateLabel()
				UpdateLabel()
			else
				ClearAll()
			end
			
			if gunDropEsp then
				ForceCreate("GunDrop")
			else
				clearCustom()
			end
		end
	end)
end

