	local function UpdateLabel()
		local PlayerRoles = event:InvokeServer()
		for i, v in Players:GetPlayers() do
			if (v ~= player and v.Character and v.Character:FindFirstChild("Head")) and v.Character:WaitForChild("Head"):FindFirstChild("espUser") and v.Character:FindFirstChild("esp") then
				local billboard = v.Character:WaitForChild("Head"):FindFirstChild("espUser")
				if not billboard then continue end
				
				local text =  billboard.TextLabel
				local highlight : Highlight = v.Character:WaitForChild("esp")
				
				text.Text = v.Name
				
				local playerRole = PlayerRoles[v.Name]
				
				if playerRole then
					module.Global.Roles[v.Name] = playerRole.Role
					local ROLE = playerRole.Role
					if ROLE == "Sheriff" and IsAlive(playerRole) then
						text.TextColor3 = Color3.fromRGB(0, 0, 225)
						highlight.FillColor = Color3.fromRGB(0,0,255)
					end

					if ROLE == "Murderer" and IsAlive(playerRole) then
						text.TextColor3 = Color3.fromRGB(225, 0, 0)
						highlight.FillColor = Color3.fromRGB(255,0,0)
					end

					if ROLE == "Innocent" and IsAlive(playerRole) then 
						text.TextColor3 = Color3.fromRGB(0, 225, 0)
						highlight.FillColor = Color3.fromRGB(0,255,0)
