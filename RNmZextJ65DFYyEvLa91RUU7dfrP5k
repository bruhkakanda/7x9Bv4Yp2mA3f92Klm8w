module.unsafeAutofarmFuncl = function()

	local LOCKED_Y = nil
	local canReset = true

	local SPEED = 20

	local NO_COIN_TIMEOUT = 5
	local lastCoinSeen = os.clock()

	local char = game.Players.LocalPlayer.Character or game.Players.LocalPlayer.CharacterAdded:Wait()

	local humanoid = game.Players.LocalPlayer.Character:WaitForChild("Humanoid")

	game["Run Service"].Stepped:Connect(function()
		if module.Global.noclip then
			for _, v in game.Players.LocalPlayer.Character:GetDescendants() do
				if v:IsA("BasePart") then
					v.CanCollide = false
				end
			end
		end
	end)


	local function getClosestCoin(root)
		local closestCoin = nil
		local closestDist = math.huge

		local CoinContainer = workspace:FindFirstChild("CoinContainer", true)

		if CoinContainer then
			for _, v in CoinContainer:GetChildren() do
				local coin = v:FindFirstChild("CoinVisual")
				if coin and coin:FindFirstChild("MainCoin") then
					if coin.MainCoin.Transparency == 0 then
						local dist = (coin.Position - root.Position).Magnitude
						if dist < closestDist then
							closestDist = dist
							closestCoin = coin
						end
					end
				end
			end
		end

		return closestCoin, closestDist
	end

		task.spawn(function()
		while task.wait(0.2) do
			if module.Global.unsafe_coinAutofarm then
				local char = game.Players.LocalPlayer.Character
				if char and char.Parent and char:FindFirstChild("Humanoid") then
					local humanoid = char:WaitForChild("Humanoid")
					local root = char.PrimaryPart


					local coinVisual, distance = getClosestCoin(root)
					local coin = nil

					if coinVisual then
						if coinVisual.Parent then
							if coinVisual:FindFirstChild("MainCoin") then
								coin = coinVisual.Parent
							end
						end
					end

					if not coinVisual or not coinVisual.Parent then

						if os.clock() - lastCoinSeen < NO_COIN_TIMEOUT then
							continue
						else
							if canReset then
								module.Global.noclip = false
								humanoid.PlatformStand = false
								workspace.Gravity = 196.2
								humanoid.Health = 0
								canReset = false
							end
						end
					else
						canReset = true
						lastCoinSeen = os.clock()
						module.Global.noclip = true
						humanoid.PlatformStand = true
						workspace.Gravity = 0
					end


					lastCoinSeen = os.clock()

					if coin and coin.Parent then

						if not LOCKED_Y then
							LOCKED_Y = root.Position.Y
						end

						local targetY = coin.Position.Y - (coin.Size.Y / 2) - 2
						if math.abs(targetY - LOCKED_Y) > 0.1 then
							LOCKED_Y = targetY -- move Y to coin's Y
						end
						local targetCFrame =
							CFrame.new(coin.Position.X, LOCKED_Y, coin.Position.Z) *
							CFrame.Angles(math.rad(90), 0, 0)

						while true do
							local dt = task.wait(0.01)

							if not coinVisual or not coinVisual.Parent then
								break
							end

							if coinVisual:FindFirstChild("MainCoin") then
								if coinVisual.MainCoin.Transparency ~= 0 then
									break
								end
							end

							if not module.Global.unsafe_coinAutofarm then
								break
							end

							local CoinContainers = workspace:FindFirstChild("CoinContainer", true)
							if CoinContainers then
								for _, coinAura in CoinContainers:GetChildren() do
									if coinAura and coinAura:FindFirstChild("CoinVisual") and coinAura:FindFirstChild("CoinVisual"):FindFirstChild("MainCoin") then
										if coinAura:FindFirstChild("CoinVisual") then
											if coinAura.CoinVisual:FindFirstChild("MainCoin") then
												if coinAura.CoinVisual.MainCoin.Transparency == 0 then
													local dist = (root.Position - coinAura.Position).Magnitude
													if dist < 5 then
														coinAura.Position = root.Position
													end
												end
											end
										end
									end
								end
							end

							local currentPos = root.Position
							local targetPos = Vector3.new(
								coin.Position.X,
								LOCKED_Y,
								coin.Position.Z
							)

							local direction = targetPos - currentPos
							local dist = direction.Magnitude

							if dist > 0 then
								local step = math.min(SPEED * dt, dist)
								local newPos = currentPos + direction.Unit * step
								root.CFrame = CFrame.new(newPos) * CFrame.Angles(math.rad(90), 0, 0)
							end

							if dist < 0.5 then
								break
							end
						end
					end
				end
			else
				workspace.Gravity = 196.2
				module.Global.noclip = false
				local char = game.Players.LocalPlayer.Character
				if char and char:FindFirstChild("Humanoid") then
					char.Humanoid.PlatformStand = false
				end
				LOCKED_Y = nil
			end
		end
		end)
end

module.CoinAutofarmFuncl = function()
	local coinInfo = script.CoinInfo
	coinInfo.Parent = script.Parent.Parent.Parent

	local TOTAL_COLLECTED = 0
	local COINS_PER_HOUR = 0
	local STATUS = "Waiting..."

	local lastCollectTime = nil
	local collectionIntervals = {}
	local MAX_INTERVAL_SAMPLES = 20
	
	local lastCollectedTime = os.clock()
	local STUCK_TIMEOUT = 8 

	local activeCoin = nil
	local REROUTE_MARGIN = 5
	local REROUTE_CHECK_INTERVAL = 0.5
	local WAYPOINT_TIMEOUT = 5

	local autofarmConnection = nil
	
	local failedCoins = {}
	local FAILED_COIN_COOLDOWN = 10
	
	local function disableControls()
		local humanoid = player.Character and player.Character:FindFirstChild("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = 0
			humanoid.JumpPower = 0
		end
	end

	local function enableControls()
		local humanoid = player.Character and player.Character:FindFirstChild("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = 16
			humanoid.JumpPower = 50
		end
	end

	local function isCoinBlacklisted(coin)
		local t = failedCoins[coin]
		if not t then return false end
		if os.clock() - t > FAILED_COIN_COOLDOWN then
			failedCoins[coin] = nil
			return false
		end
		return true
	end

	local function isCoinValid(coin)
		if not coin or not coin.Parent then return false end
		local visual = coin:FindFirstChild("CoinVisual")
		if not visual then return false end
		local mainCoin = visual:FindFirstChild("MainCoin")
		if not mainCoin or mainCoin.Transparency ~= 0 then return false end
		return true
	end

	local function getNearestCoin(hrp)
		local coinFolder = workspace:FindFirstChild("CoinContainer", true)
		if not coinFolder then return nil end

		local nearestCoin = nil
		local nearestDistance = math.huge

		for _, coinServer in coinFolder:GetChildren() do
			if isCoinValid(coinServer) and not isCoinBlacklisted(coinServer) then
				local distance = (coinServer.Position - hrp.Position).Magnitude
				if distance < nearestDistance then
					nearestCoin = coinServer
					nearestDistance = distance
				end
			end
		end

		return nearestCoin
	end

	local function updateCoinsPerHour()
		local now = os.clock()
		lastCollectedTime = now


		if lastCollectTime then
			local gap = now - lastCollectTime
			table.insert(collectionIntervals, gap)

			if #collectionIntervals > MAX_INTERVAL_SAMPLES then
				table.remove(collectionIntervals, 1)
			end
		end

		lastCollectTime = now

		if #collectionIntervals > 0 then
			local sum = 0
			for _, gap in collectionIntervals do
				sum += gap
			end
			local avgInterval = sum / #collectionIntervals

			if avgInterval > 0 then
				COINS_PER_HOUR = math.floor(3600 / avgInterval)
			end
		end
	end

	local function Collect(coin, hrp)
		local visual = coin:FindFirstChild("CoinVisual")
		if not visual then return end

		STATUS = "Collecting..."

		local startTime = os.clock()
		local TIMEOUT = 3

		while true do
			if not isCoinValid(coin) then return end
			if os.clock() - startTime > TIMEOUT then return end

			local dist = (coin.Position - hrp.Position).Magnitude
			if dist < 5 then
				coin.CFrame = hrp.CFrame
				TOTAL_COLLECTED += 1
				updateCoinsPerHour()
				return
			elseif dist > 5 and dist < 10 then
				coin.CFrame = hrp.CFrame
				TOTAL_COLLECTED += 1
				updateCoinsPerHour()
				return
			end

			task.wait(0.1)
		end
	end

	local function getPathLength(startPos, targetPos)
		local testPath = PathfindingService:CreatePath({
			AgentRadius = 2,
			AgentHeight = 5,
			AgentCanJump = true,
			AgentCanClimb = true,
		})

		local ok = pcall(function()
			testPath:ComputeAsync(startPos, targetPos)
		end)

		if not ok or testPath.Status ~= Enum.PathStatus.Success then
			return math.huge
		end

		local waypoints = testPath:GetWaypoints()
		local length = 0
		for i = 2, #waypoints do
			length += (waypoints[i].Position - waypoints[i - 1].Position).Magnitude
		end

		return length
	end

	local function waitForWaypoint(humanoid, hrp, coin)
		local reached = false
		local rerouted = false
		local broken = false

		local conn
		conn = humanoid.MoveToFinished:Connect(function(didReach)
			reached = true
		end)

		local startTime = os.clock()
		local lastRerouteCheck = 0

		while not reached do
			if os.clock() - startTime > WAYPOINT_TIMEOUT then
				broken = true
				break
			end

			if not isCoinValid(coin) then
				broken = true
				break
			end

			local character = player.Character
			local currentHrp = character and character:FindFirstChild("HumanoidRootPart")
			if not currentHrp then
				broken = true
				break
			end

			if os.clock() - lastRerouteCheck >= REROUTE_CHECK_INTERVAL then
				lastRerouteCheck = os.clock()
				local closer = getNearestCoin(currentHrp)
				if closer and closer ~= coin then
					local closerPathLen = getPathLength(currentHrp.Position, closer.Position)
					local currentPathLen = getPathLength(currentHrp.Position, coin.Position)
					if closerPathLen < currentPathLen - REROUTE_MARGIN then
						rerouted = true
						break
					end
				end
			end

			task.wait(0)
		end

		conn:Disconnect()
		return reached, rerouted, broken
	end

	local function navigateToCoin(coin)
		local indicators = {}
		local handles = nil

		local success, err = pcall(function()
			local character = player.Character
			local hrp = character and character:FindFirstChild("HumanoidRootPart")
			local humanoid = character and character:FindFirstChild("Humanoid")
			if not hrp or not humanoid then return end

			STATUS = "Moving..."

			local newPath = PathfindingService:CreatePath({
				AgentRadius = 1,
				AgentHeight = 5,
				AgentCanJump = true,
				AgentCanClimb = true,
			})

			-- Offset target slightly above coin to avoid geometry issues
			local targetPos = coin.Position + Vector3.new(0, 2, 0)
			newPath:ComputeAsync(hrp.Position, targetPos)

			if newPath.Status ~= Enum.PathStatus.Success then
				
				failedCoins[coin] = os.clock()
				return
			end

			local waypoints = newPath:GetWaypoints()
			local totalWaypoints = #waypoints
			local finishedWaypoints = 0

			for i, waypoint in waypoints do
				local indicatorPart = Instance.new("Part")
				indicatorPart.Size = Vector3.new(0.5, 0.5, 0.5)
				indicatorPart.Anchored = true
				indicatorPart.CanCollide = false
				indicatorPart.Transparency = 0
				indicatorPart.Color = Color3.new(0.388235, 1, 0.321569)
				indicatorPart.Position = waypoint.Position
				indicatorPart.Material = Enum.Material.Neon
				indicatorPart.Shape = Enum.PartType.Ball
				indicatorPart.Parent = workspace
				indicators[i] = indicatorPart
			end

			handles = Instance.new("BoxHandleAdornment")
			handles.Parent = coin
			handles.Adornee = coin
			handles.AlwaysOnTop = true
			handles.Color3 = Color3.fromRGB(251, 255, 1)
			handles.ZIndex = 10

			local wasRerouted = false

			for i, waypoint in waypoints do
				local currentCharacter = player.Character
				local currentHrp = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
				local currentHumanoid = currentCharacter and currentCharacter:FindFirstChild("Humanoid")

				if not currentHrp or not currentHumanoid or not isCoinValid(coin) then break end

				if waypoint.Action == Enum.PathWaypointAction.Jump then
					currentHumanoid:ChangeState(Enum.HumanoidStateType.Jumping)
				end

				currentHumanoid:MoveTo(waypoint.Position)
				local reached, rerouted, broken = waitForWaypoint(currentHumanoid, currentHrp, coin)

				if indicators[i] then
					indicators[i]:Destroy()
					indicators[i] = nil
				end

				if rerouted or broken then
					wasRerouted = rerouted
					break
				end

				finishedWaypoints += 1
			end

			if not wasRerouted and finishedWaypoints == totalWaypoints then
				local finalCharacter = player.Character
				local finalHrp = finalCharacter and finalCharacter:FindFirstChild("HumanoidRootPart")
				if finalHrp then
					Collect(coin, finalHrp)
				end
			end
		end)

		if handles then
			handles:Destroy()
		end
		for _, v in indicators do
			if v and v.Parent then
				v:Destroy()
			end
		end

		if not success then
			
		end

		STATUS = "Waiting..."
	end

	if autofarmConnection then
		return
	end

	autofarmConnection = RunService.Heartbeat:Connect(function(dT)

		if coinInfo.Visible then
			coinInfo.Status.Text = `Status: {STATUS}`
			coinInfo.Hour.Text = `{COINS_PER_HOUR} per hour`
			coinInfo.Coins.Text = `Collected: {TOTAL_COLLECTED}`
		end

		if module.Global.coinAutofarm and not activeCoin then
			coinInfo.Visible = true

			local character = player.Character
			if not character then return end

			local hrp = character:FindFirstChild("HumanoidRootPart")
			local humanoid = character:FindFirstChild("Humanoid")
			if not hrp or not humanoid then return end

			-- Stuck check
			if os.clock() - lastCollectedTime > STUCK_TIMEOUT then
				local nearest = getNearestCoin(hrp)
				if nearest then
					hrp.CFrame = nearest.CFrame + Vector3.new(0, 3, 0)
					lastCollectedTime = os.clock()  -- reset timer
					failedCoins = {}  -- clear blacklist since we moved
				end
				return
			end

			local coin = getNearestCoin(hrp)
			if coin then
				activeCoin = coin
				STATUS = "Getting Coin..."
				task.spawn(function()
					navigateToCoin(coin)
					activeCoin = nil
				end)
			else
				STATUS = "Waiting..."
			end
		elseif not module.Global.coinAutofarm then
			coinInfo.Visible = false
		end
	end)
end



return module

end;
